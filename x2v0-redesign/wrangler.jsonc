{
  // Static site on Cloudflare Workers: everything in deploy/ is served as is.
  // Rebuild deploy/ with tools/make_deploy.sh, then run: npx wrangler@4 deploy
  "name": "x2v0-resume",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./deploy",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
